{
  "name": "devdock",
  "version": "1.0.0",
  "description": "DevDock - Developer Dashboard & Workspace Hub",
  "main": "main.js",
  "author": "Shahriyar",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test",
    "integrations:install": "node scripts/install-integrations.js",
    "integrations:uninstall": "node scripts/uninstall-integrations.js",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.devdock.app",
    "productName": "DevDock",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "index.css",
      "core.js",
      "scripts/**",
      "integrations/**"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Development",
      "maintainer": "Shahriyar <devdock@example.com>",
      "executableName": "devdock-app",
      "extraFiles": [
        {
          "from": "scripts/devdock-wrapper.sh",
          "to": "bin/devdock"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "extraFiles": [
        {
          "from": "scripts/devdock-wrapper.cmd",
          "to": "bin/devdock.cmd"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "asarUnpack": [
      "core.js",
      "scripts/**",
      "integrations/**"
    ],
    "deb": {
      "afterInstall": "scripts/deb-postinst.sh",
      "afterRemove": "scripts/deb-postrm.sh"
    }
  },
  "bin": {
    "devdock": "scripts/cli.js"
  },
  "homepage": "https://github.com/shahriyar/devdock",
  "repository": {
    "type": "git",
    "url": "https://github.com/shahriyar/devdock.git"
  }
}