{
  "name": "devdock",
  "version": "1.0.0",
  "description": "DevDock - Developer Dashboard & Workspace Hub",
  "main": "main.js",
  "author": "Shahriyar",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.devdock.app",
    "productName": "DevDock",
    "files": ["main.js", "preload.js", "renderer.js", "index.html", "index.css"],
    "linux": { "target": ["deb", "AppImage"], "category": "Development" },
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.developer-tools" },
    "nsis": { "deleteAppDataOnUninstall": false }
  }
}
